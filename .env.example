# 로컬 개발 (SQLite)
DATABASE_URL="file:./dev.db"

# Vercel 배포 시 (Postgres) — prisma/schema.prisma의 provider도 postgresql로 바꿔야 한다.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# 세션 쿠키 암호화 키. 32자 이상. 아래 명령으로 생성한다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-with-a-long-random-string"

# 문서함 파일 저장소 (Vercel Blob).
# 없으면 문서함이 "스토리지 미설정" 안내를 보여주고 업로드를 막는다.
# Vercel 대시보드 > Storage > Blob 에서 스토어를 만들면 발급된다.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
