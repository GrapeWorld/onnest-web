# PostgreSQL
# 로컬·운영 공통 연결 문자열. 반드시 실제 PostgreSQL을 가리켜야 한다(예전처럼
# 로컬 SQLite로 대체할 수 없다 — prisma/schema.prisma의 provider가 postgresql로
# 고정되어 있다). `docker compose up -d`로 docker-compose.yml의 로컬 Postgres를
# 띄운 경우 예시:
#   DATABASE_URL="postgresql://onnest:onnest@localhost:5432/onnest"
# 필수. 값이 없거나 postgresql://·postgres://로 시작하지 않으면 시작 시 실패한다.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Application
# 서비스 정식 URL. 이메일 링크 등 서버가 생성하는 절대 URL의 기준 origin으로
# 쓴다 — 요청 Host 헤더는 프록시 설정에 따라 실제 서비스 도메인과 다를 수 있어
# 신뢰하지 않는다. http:// 또는 https://로 시작해야 하며 path/query/fragment는
# 포함하면 안 된다(도메인만). 운영에서는 필수이며 없거나 형식이 잘못되면 시작
# 시 실패한다. 로컬은 비워두면 http://localhost:3000으로 자동 대체된다.
APP_URL="http://localhost:3000"

# Authentication
# 세션 쿠키 암호화 키. 32자 이상 랜덤 문자열. 아래 명령으로 생성한다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 필수. 개발용 기본값을 운영에 그대로 쓰지 않는다. 운영 중 값을 바꾸면 그
# 시점에 발급된 모든 세션 쿠키가 즉시 무효화된다(재로그인 필요).
SESSION_SECRET="replace-with-a-long-random-string"

# Email (선택 — 아이디 찾기·비밀번호 재설정 메일 발송)
# 없으면 실제 발송 대신 콘솔에 수신자(마스킹됨)·제목만 남기고 건너뛴다.
# 메일 본문이나 재설정 토큰은 로컬이든 운영이든 로그에 남기지 않는다.
# resend.com에서 발신 도메인을 인증(SPF/DKIM)하고 API 키를 발급받는다.
# 도메인 인증 전에는 계정 소유자 본인 이메일로만 테스트 발송이 된다.
# 둘 중 하나만 설정하면 시작 시 실패한다 — 항상 함께 설정한다.
# RESEND_API_KEY="re_..."
# RESEND_FROM="ONNEST <no-reply@onnesthome.com>"

# 운영 알림 수신 주소(선택 — 신규 문의·서비스 연결 신청 발생 시 알림 발송).
# 없으면 알림 발송을 건너뛰고 콘솔에만 남긴다. 설정한다면 RESEND_API_KEY도
# 함께 설정해야 실제로 발송된다(둘 다 없으면 콘솔 로그로만 남는다).
# ADMIN_NOTIFICATION_EMAIL="ops@onnesthome.com"

# 소셜 로그인 (선택 — Google/Kakao/Naver)
# provider별로 clientId+clientSecret을 둘 다 설정해야 그 provider의 로그인
# 버튼이 노출된다(하나만 있으면 그 provider는 그냥 숨겨진다 — 시작 시 실패하지
# 않는다). Client Secret은 절대 NEXT_PUBLIC_ 접두사를 붙이지 않는다 — 브라우저
# 번들에 노출되면 안 되는 서버 전용 값이다. redirect URI는 각 콘솔에 아래
# 형식으로 정확히 등록해야 한다(콜백 라우트가 provider별로 고정돼 있다).
#   {APP_URL}/api/auth/oauth/google/callback
#   {APP_URL}/api/auth/oauth/kakao/callback
#   {APP_URL}/api/auth/oauth/naver/callback
# 자세한 콘솔 설정 절차는 docs/DEPLOY.md의 "소셜 로그인" 절을 참고한다.
# GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"
# GOOGLE_CLIENT_SECRET="GOCSPX-..."
# KAKAO_CLIENT_ID="..."
# KAKAO_CLIENT_SECRET="..."
# NAVER_CLIENT_ID="..."
# NAVER_CLIENT_SECRET="..."

# 문의 지연 경고 크론(선택 — 없으면 /api/cron/inquiry-sla가 항상 401을
# 돌려주고 배포된 크론 스케줄이 있어도 그냥 실패한다. 나머지 기능은
# 영향받지 않는다). vercel.json에 이미 등록된 스케줄(매일 00:00 UTC)에
# Vercel이 이 값을 Authorization: Bearer 헤더로 자동 첨부한다.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRON_SECRET="replace-with-a-long-random-string"

# Blob Storage (선택 — 문서함)
# 없으면 문서함 업로드 API가 503을 돌려주고 화면은 "스토리지 미설정" 안내를
# 보여준다. 나머지 기능은 영향받지 않는다.
# Vercel 대시보드 > Storage > Blob 에서 스토어를 만들면 발급된다.
# 서버 전용 값이다 — 클라이언트 번들에 노출되지 않도록 NEXT_PUBLIC_ 접두사를
# 붙이지 않는다.
# BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
