// 로컬과 운영이 같은 마이그레이션 이력을 사용하도록 Postgres를 기준 DB로 쓴다.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  // 소셜 전용 회원은 비밀번호가 없다. 이메일·비밀번호 로그인 라우트는 이 값이
  // null이면 bcrypt.compare를 아예 호출하지 않고 일반 로그인 실패로 처리한다.
  passwordHash String?
  authVersion  Int       @default(0)
  name         String
  phone        String?
  role         String    @default("user")
  // 회원 상태. ACTIVE|PENDING|DORMANT|SUSPENDED|WITHDRAWN|BLOCKED
  // (src/data/memberStatus.ts). 소프트 삭제 용도 — 관리자가 탈퇴 처리해도
  // 이 필드만 바뀌고 행 자체는 남는다. 본인이 직접 탈퇴하는 기존
  // delete-account 흐름은 여전히 실제 삭제다(별개 정책).
  status        String    @default("ACTIVE")
  lastLoginAt   DateTime?
  // 관리자 권한 등급. null(관리자 아님) | "super" | "viewer"
  // (src/lib/auth.ts의 isAdmin/isSuperAdmin). role(서비스 역할)과는 별개
  // 개념이라 분리했다 — "일반 회원에게 role=admin만 부여" 방식을 쓰지 않는다.
  adminRole     String?
  // 가입 시 약관·개인정보처리방침 동의 시각. 이 기능 이전 가입자는 null이다.
  termsAgreedAt DateTime?
  // 일반 회원 유형. "CUSTOMER" | "PARTNER" (src/data/memberType.ts). adminRole과는
  // 별개 축이다 — 관리자 화면의 표시 분류는 adminRole을 우선 적용하고, adminRole이
  // 없을 때만 이 값으로 업체/고객을 가른다. 관리자 권한이 회수돼도 이 값은 그대로
  // 남아 있어 원래 유형으로 자연스럽게 돌아간다.
  memberType    String    @default("CUSTOMER")
  // PARTNER 회원이 연결된 업체(Partner). 로그인 계정과 Partner 참조 목록을 잇는
  // 다리일 뿐, 이 관계 자체가 파트너 포털 권한을 주지 않는다.
  partnerId     String?
  partner       Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  createdAt    DateTime  @default(now())
  projects     Project[]
  resetTokens  PasswordResetToken[]
  statusHistory MemberStatusHistory[]
  adminNotes    AdminMemberNote[]
  roleHistory   AdminRoleHistory[]
  memberTypeHistory MemberTypeHistory[]
  // 이 관리자에게 배정된 문의. Inquiry.owner(레거시 자유입력 문자열)를 대체한다.
  // 이름이 겹치지 않도록 명시적 relation 이름을 쓴다(향후 다른 User↔Inquiry
  // 관계가 추가돼도 안전하게 구분된다).
  assignedInquiries Inquiry[] @relation("InquiryAssignee")
  socialAccounts    SocialAccount[]
  // 이 업체 직원(memberType="PARTNER")에게 담당으로 지정된 서비스 신청.
  // 이름이 겹치지 않도록 명시적 relation 이름을 쓴다.
  assignedServiceRequests ServiceRequest[] @relation("ServiceRequestPartnerStaff")
  // 이 회원이 접수했거나(로그인 상태로 제출) 나중에 연결한 문의. 담당자
  // 관계(InquiryAssignee)와 겹치지 않도록 명시적 이름을 쓴다.
  inquiries         Inquiry[]          @relation("InquiryOwner")
  inquiryLinkTokens InquiryLinkToken[]
  partnerMemberships PartnerMembership[]
}

// Google/Kakao/Naver 계정 연결. provider+providerAccountId(이메일이 아니라
// provider가 주는 영구 subject/id)로 로그인 사용자를 찾는다 — 이메일이
// 같다는 이유만으로 다른 계정을 자동 연결하지 않기 위한 핵심 방어선이다.
// 로그인 용도로만 쓰므로 access/refresh token은 저장하지 않는다(필요해지면
// 별도 암호화 저장 설계를 다시 한다).
model SocialAccount {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "google" | "kakao" | "naver"
  provider          String
  providerAccountId String
  providerEmail     String?
  emailVerified     Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([provider, providerAccountId])
  @@index([userId])
}

// 회원 구분(고객·업체) 변경 이력. MemberStatusHistory/AdminRoleHistory와 같은
// 원칙으로 이 액션 자체가 자기 감사 로그를 겸한다.
model MemberTypeHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromType      String
  toType        String
  fromPartnerId String?
  toPartnerId   String?
  reason        String
  actorId       String
  actorEmail    String
  createdAt     DateTime @default(now())

  @@index([userId, createdAt])
}

// 관리자 권한 등급 부여·변경·회수 이력. MemberStatusHistory와 같은 원칙으로
// 이 액션 자체가 자기 감사 로그를 겸한다.
model AdminRoleHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromRole   String?
  toRole     String?
  reason     String
  actorId    String
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// 관리자의 회원 상태 변경 이력. 사유·처리자·전후값을 담고 있어 이 액션
// 자체의 감사 로그를 겸한다.
model MemberStatusHistory {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  reason     String
  // Inquiry.owner/ServiceRequest.owner와 같은 원칙으로 처리 관리자를 FK가
  // 아니라 처리 시점의 id/이메일 문자열로 남긴다(관리자 역할 테이블이
  // 아직 없다).
  adminId    String
  adminEmail String
  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
}

// 관리자가 회원에게 남기는 내부 메모. 일반 사용자에게는 노출하지 않는다.
model AdminMemberNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorId    String
  authorEmail String
  body        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, createdAt])
}

// 비밀번호 재설정 링크의 토큰. 원문 대신 해시만 저장해 DB가 유출돼도
// 토큰 자체는 못 쓰게 한다(passwordHash와 같은 원칙).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Project {
  id         String             @id @default(cuid())
  userId     String
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  // 세부 공간유형의 한글 라벨을 저장한다(예: "아파트", "일반 사무실").
  // 예전에는 4종 고정값이었지만 지금은 src/data/projectSpace.ts의
  // 세부유형 라벨이 들어간다 — 기존 표시 코드가 그대로 문자열로 보여주므로
  // 컬럼명·타입은 바꾸지 않았다.
  spaceType  String
  // "residential" | "office" | "commercial" | "industrial". 새 위저드로 저장한
  // 행에는 항상 채워지지만, 이전 행에는 없을 수 있어 nullable로 둔다.
  spaceCategory String?
  // "purchase" | "jeonse" | "monthly_rent" | "lease" | "undecided"
  transactionType String?
  address    String?
  // 주소를 아직 정하지 못했다는 사용자의 명시적 선택. true면 address가
  // 비어 있어도 정상이다.
  addressPending Boolean @default(false)
  moveInDate DateTime?
  // 계약 예정일. moveInDate(입주·사용 개시 예정일)와는 별개 일정이다.
  contractDate DateTime?
  // 일정을 아직 정하지 못했다는 사용자의 명시적 선택. true면 moveInDate·
  // contractDate가 비어 있어도 정상이다.
  scheduleUndecided Boolean @default(false)
  budget     String?
  // "searching" | "candidate_selected" | "visit_planned" | "contract_review" |
  // "contract_completed" | "move_in_preparing" — 사용자가 스스로 신고한 현재
  // 진행 상황. 입주 10단계(ProjectStepState)와는 다른 개념으로, 생성 직후
  // 10단계 체크리스트의 시작 지점을 정하는 데만 쓴다.
  projectStage String?
  // 거래유형·공간별 조건부 필드(희망가, 보증금, 권리금, 전력 용량 등).
  // 종류가 너무 많고 대부분 특정 조합에서만 쓰여 컬럼을 늘리는 대신 하나의
  // 검증된 JSON에 담는다. Postgres 전환 이후에만 안전하게 쓸 수 있는 타입이다.
  details    Json?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  stepStates ProjectStepState[]
  checks     ProjectCheckItem[]
  events     ProjectEvent[]
  requests   ServiceRequest[]
  documents  Document[]
  handover   Handover?

  @@index([userId, createdAt])
}

// 계약서·등기부·현장 사진. 파일 자체는 외부 스토리지에 비공개로 있고
// 여기에는 경로(storageKey)만 둔다. 공개 URL은 존재하지 않으며,
// 소유권을 확인한 API가 서버 토큰으로 읽어서 중계한다.
model Document {
  id         String   @id @default(cuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  filename   String
  mimeType   String
  size       Int
  storageKey String
  createdAt  DateTime @default(now())
  // 특정 서비스 신청(파트너 포털)에 딸린 파일이면 채워진다. 일반 프로젝트
  // 문서함 파일은 null이다.
  serviceRequestId String?
  serviceRequest   ServiceRequest? @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  // "QUOTE" | "PHOTO" | "CONTRACT" — 서비스 신청 파일에서만 쓴다. 일반
  // 프로젝트 문서함 파일은 null.
  category String?
  // "CUSTOMER" | "PARTNER" — 누가 올렸는지. 프로젝트 문서함은 항상 고객
  // 본인이 올리므로 기본값 CUSTOMER로 두고 별도 UPDATE 없이 기존 행에도
  // 그대로 적용된다.
  uploadedByRole String  @default("CUSTOMER")
  uploadedById   String?
  uploadedByName String?
  // 업로드 당시 이 요청을 담당하던 업체(서비스 신청 파일에서만 쓴다).
  // 재배정 후 다른 업체가 예전 견적서·계약서·사진을 보거나 지우지
  // 못하게 막는 스냅샷이다 — uploadedById 등과 같은 원칙.
  partnerId String?

  @@index([projectId, createdAt])
  @@index([serviceRequestId, createdAt])
}

// 이사·청소·인터넷 등 파트너 연결 신청. 서비스 유형마다 담당 파트너가 달라
// 여러 개를 한 번에 신청해도 유형별로 한 건씩 만든다.
// serviceType과 status 값은 src/data/serviceRequests.ts와 대응한다.
model ServiceRequest {
  id            String    @id @default(cuid())
  projectId     String
  project       Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  serviceType   String
  preferredDate DateTime?
  region        String
  message       String?
  contactName   String
  contactPhone  String
  // "신규" | "확인 중" | "상담 완료" | "견적 전달" | "작업 예정" | "작업 완료" |
  // "취소" (src/data/serviceRequests.ts). 관리자와 배정된 업체가 같은 값을
  // 본다 — 업체 포털에서 바뀐 상태가 곧 관리자 화면의 상태다.
  status        String    @default("신규")
  owner         String?
  // 이 신청을 넘긴 외주 업체(이사짐센터 등). 업체 로그인 계정이 아니라
  // 관리자가 배정할 때 고르는 참조 목록(Partner)에 대한 FK다.
  partnerId     String?
  partner       Partner?  @relation(fields: [partnerId], references: [id], onDelete: SetNull)
  // 배정된 업체 안에서 이 건을 실제로 처리하는 직원(User.memberType="PARTNER").
  // partnerId와 같은 업체 소속인지는 API에서 매번 검증한다 — 스키마 제약만으로는
  // "같은 업체 소속"을 강제할 수 없다.
  partnerStaffId String?
  partnerStaff   User?    @relation("ServiceRequestPartnerStaff", fields: [partnerStaffId], references: [id], onDelete: SetNull)
  // 연락처를 파트너에게 전달하는 것에 동의한 시각. 이 기능 이전 신청은 null이다.
  privacyAgreedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  activities    ServiceRequestActivity[]
  documents     Document[]
  // 배정된 업체가 제시한 견적 옵션 전체(선택 여부 무관).
  quotes          ServiceRequestQuote[] @relation("ServiceRequestQuotes")
  // 고객이 선택한 견적(quotes 중 하나). @unique라서 같은 견적을 두 요청이
  // 동시에 선택하는 일이 DB 레벨에서 불가능하다.
  selectedQuoteId String?               @unique
  selectedQuote   ServiceRequestQuote?  @relation("ServiceRequestSelectedQuote", fields: [selectedQuoteId], references: [id], onDelete: SetNull)
  // 고객이 선택(또는 변경)을 완료한 시각. 선택 전에는 null.
  selectedAt      DateTime?

  @@index([status, createdAt])
  @@index([projectId, createdAt])
  @@index([partnerId, createdAt])
}

// 배정된 단일 업체가 한 서비스 신청에 제시하는 견적 옵션(예: "기본형"/
// "프리미엄형"). 여러 업체가 경쟁하는 마켓플레이스가 아니라 한 업체가 여러
// 가격안을 제시하는 모델이다. 생성·삭제만 지원한다 — 수정 API는 의도적으로
// 만들지 않는다. 가격을 조용히 고치는 대신 삭제 후 재등록하게 해
// ServiceRequestActivity 감사 로그에 항상 흔적이 남게 한다.
model ServiceRequestQuote {
  id               String   @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation("ServiceRequestQuotes", fields: [serviceRequestId], references: [id], onDelete: Cascade)
  title            String
  description      String?
  // KRW, 원 단위 정수. 상한(10억 원)은 API 검증(zod)에서 강제한다.
  amount           Int
  // 등록한 업체 직원의 스냅샷(ServiceRequestActivity.actorId/actorName과
  // 같은 원칙) — 나중에 직원 계정이 바뀌어도 등록 당시 이름이 남는다.
  createdById      String?
  createdByName    String?
  createdAt        DateTime @default(now())
  // 이 견적을 선택한 요청(있다면 하나뿐). ServiceRequest.selectedQuoteId 참고.
  selectedByRequest ServiceRequest? @relation("ServiceRequestSelectedQuote")

  @@index([serviceRequestId, createdAt])
}

// 서비스 신청의 상태·담당직원·메모·연락기록 전체 이력을 남기는 append-only
// 감사 로그. InquiryActivity(F2)와 완전히 같은 원칙 — 수정·삭제 API를
// 의도적으로 만들지 않는다.
// action: STATUS_CHANGED|STAFF_ASSIGNED|STAFF_UNASSIGNED|NOTE_ADDED|CONTACT_LOGGED|
// QUOTE_ADDED|QUOTE_REMOVED|QUOTE_SELECTED
model ServiceRequestActivity {
  id               String   @id @default(cuid())
  serviceRequestId String
  serviceRequest   ServiceRequest @relation(fields: [serviceRequestId], references: [id], onDelete: Cascade)
  action           String
  changes          Json?
  note             String?
  actorId          String?
  actorEmail       String?
  actorName        String?
  // "ADMIN" | "PARTNER" | "CUSTOMER" — 관리자·업체 직원·고객 모두 같은
  // 요청에 흔적을 남길 수 있어 누가 처리자인지 구분해 둔다.
  actorRole        String
  createdAt        DateTime @default(now())
  // 작성 당시 이 요청을 담당하던 업체. 재배정 후 다른 업체가 예전 내부
  // 메모·연락 기록을 보지 못하게 막는 스냅샷이다(actorId 등과 같은 원칙).
  partnerId String?

  @@index([serviceRequestId, createdAt])
}

// 이사·청소 등 실제 서비스를 수행하는 외주 업체. 로그인 계정이 아니라
// 관리자가 리드를 배정할 때 고르는 참조 목록이다.
model Partner {
  id           String   @id @default(cuid())
  name         String
  // src/data/serviceRequests.ts의 serviceTypes 중 하나 — 이 업체가 맡는 서비스.
  serviceType  String
  contactName  String?
  contactPhone String?
  // 관리자 전용 내부 메모 — 파트너 포털에는 절대 노출되지 않는다(super
  // admin만 조회·수정). 예전에는 이 필드와 companyDescription이 memo라는
  // 이름의 컬럼 하나를 같이 썼는데, 그러면 파트너 OWNER가 관리자의 내부
  // 메모를 읽고 덮어쓸 수 있어 컬럼을 분리했다.
  adminMemo    String?
  // 업체가 스스로 남기는 소개/메모 — 관리자 화면에서도 참고용으로 조회
  // 가능하지만, 파트너가 직접 쓰고 고치는 필드다(adminMemo와 반대).
  companyDescription String?
  // 물리적 삭제 대신 비활성화만 한다(회원 소프트 삭제와 같은 원칙) —
  // 과거 배정 기록(ServiceRequest.partnerId)이 남아있기 때문.
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  requests     ServiceRequest[]
  // 이 업체와 연결된 로그인 계정(User.memberType="PARTNER"). 업체 자체는 로그인
  // 계정이 아니며, 이 관계는 회원 분류·연결용일 뿐 파트너 포털 권한과 무관하다.
  // PartnerMembership 도입 후에도 호환용으로 계속 동기화한다.
  members      User[]
  // 외부 화면·검색에 쓰는 공개 식별자. 내부 id(cuid)와 별개로 둔다.
  partnerCode  String   @unique
  memberships  PartnerMembership[]
  invitations  PartnerInvitation[]

  @@index([serviceType, active])
}

// 업체-직원 소속 관계. User.partnerId(호환용, 계속 동기화)와 달리 이력을
// 보존한다 — REVOKED 후 다른 업체에 다시 합류해도 과거 관계가 남는다.
model PartnerMembership {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // "OWNER" | "MANAGER" | "STAFF" | "VIEWER"
  role        String
  // "ACTIVE" | "SUSPENDED" | "REVOKED"
  status      String
  invitedById String?
  invitedAt   DateTime?
  joinedAt    DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([partnerId, userId])
  @@index([userId, status])
}

// PasswordResetToken·InquiryLinkToken과 완전히 같은 원자적 소비 패턴 — 원문
// 토큰은 저장하지 않는다. 아직 계정이 없거나 없을 수도 있는 이메일 앞으로
// 보내는 것이라 PartnerMembership과는 분리된 모델이다.
model PartnerInvitation {
  id          String    @id @default(cuid())
  partnerId   String
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  email       String
  // "MANAGER" | "STAFF" | "VIEWER" — OWNER는 초대로 줄 수 없다.
  role        String
  tokenHash   String    @unique
  invitedById String
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  @@index([partnerId, email])
}

// 입주 준비 일정. date는 시각 없이 날짜만 쓰므로 UTC 자정으로 저장하고
// 표시할 때도 UTC 기준으로 읽어 시간대에 따라 하루가 밀리지 않게 한다.
model ProjectEvent {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  date      DateTime
  memo      String?
  done      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([projectId, date])
}

// 단계 안의 개별 체크리스트 항목. label은 projectSteps.ts의 checklist 문자열과 대응한다.
// 행이 없으면 미체크로 간주한다.
model ProjectCheckItem {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stepSlug  String
  label     String
  checked   Boolean  @default(false)
  updatedAt DateTime @updatedAt

  @@unique([projectId, stepSlug, label])
}

// 프로젝트당 1개. 기본은 비공개이고, 소유자가 공유를 켤 때만 shareToken이 생긴다.
model Handover {
  id         String         @id @default(cuid())
  projectId  String         @unique
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  summary    String
  visibility String         @default("private")
  shareToken String?        @unique
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  items      HandoverItem[]
  // 관리자 검수 상태. pending(검토 대기) | approved(승인) |
  // revision_requested(수정 요청) | hidden(비공개 처리). 공유 링크는
  // visibility="link"이면서 이 값이 "approved"일 때만 실제로 열린다 —
  // visibility(사용자의 공유 의도)와 이 필드(관리자의 검수 결과)는 서로
  // 독립적으로 관리된다.
  moderationStatus  String    @default("pending")
  moderationReason  String?
  moderatedAt       DateTime?
  moderatorId       String?
  moderatorEmail    String?
  moderationHistory HandoverModerationHistory[]
}

// 검수 상태 변경 이력. MemberStatusHistory/AdminRoleHistory와 같은 원칙으로
// 이 액션 자체가 자기 감사 로그를 겸한다.
model HandoverModerationHistory {
  id         String   @id @default(cuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  fromStatus String
  toStatus   String
  reason     String
  actorId    String
  actorEmail String
  createdAt  DateTime @default(now())

  @@index([handoverId, createdAt])
}

// label은 handoverRules.ts의 allowedHandoverItems 중 하나여야 한다.
model HandoverItem {
  id         String   @id @default(cuid())
  handoverId String
  handover   Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  label      String
  note       String

  @@unique([handoverId, label])
}

// slug는 src/data/projectSteps.ts의 10단계 slug와 대응한다.
// 행이 없으면 "대기"로 간주하므로 생성 시 미리 채우지 않는다.
model ProjectStepState {
  id        String   @id @default(cuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  slug      String
  status    String   @default("대기")
  updatedAt DateTime @updatedAt

  @@unique([projectId, slug])
}

// 요청 횟수 제한 기록. 서버리스에서는 메모리 카운터를 믿을 수 없어 DB에 남긴다.
// 창을 벗어난 행은 checkRateLimit이 호출될 때 함께 정리한다.
model RateLimitHit {
  id         String   @id @default(cuid())
  action     String
  identifier String
  createdAt  DateTime @default(now())

  @@index([action, identifier, createdAt])
  @@index([createdAt])
}

// 고정 시간창 단위로 요청 수를 원자적으로 증가시키는 요청 제한 버킷.
// RateLimitHit은 기존 마이그레이션 호환을 위해 남겨 두고 신규 요청에는 이 모델을 쓴다.
model RateLimitBucket {
  action      String
  identifier  String
  windowStart DateTime
  count       Int      @default(0)
  expiresAt   DateTime

  @@id([action, identifier, windowStart])
  @@index([expiresAt])
}

model Inquiry {
  id              String   @id @default(cuid())
  name            String
  organization    String?
  email           String
  phone           String
  type            String
  region          String?
  spaceType       String?
  message         String
  status          String   @default("신규")
  // 레거시 자유입력 담당자 문자열. 더 이상 쓰지 않지만(신규 배정은 assigneeId만
  // 쓴다) 과거 데이터 손실을 막기 위해 컬럼은 남겨 둔다.
  owner           String?
  // 실제 관리자 계정(User, adminRole이 있는 계정만)에 배정한다. owner와 달리
  // 자유 문자열이 아니라 FK라서 존재하지 않는 사람에게 배정되는 일이 없다.
  assigneeId      String?
  assignee        User?    @relation("InquiryAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  nextAction      String?
  privacyAgreedAt DateTime
  // 로그인 상태로 접수하면 즉시 연결된다. 비회원 접수는 null로 남고,
  // 나중에 이메일 인증(InquiryLinkToken)을 거쳐 회원 계정에 연결할 수 있다.
  userId          String?
  user            User?    @relation("InquiryOwner", fields: [userId], references: [id], onDelete: SetNull)
  // 문의 종료("답변 완료") 후 1회 남기는 만족도 평가. 이력 테이블이 아니라
  // 인라인 필드로 두는 이유는 문의당 값이 하나뿐이라서다 — 제출 자체는
  // InquiryActivity에 SATISFACTION_RATED로 한 번 기록해 감사 로그를 겸한다.
  satisfactionRating        Int?
  satisfactionComment       String?
  satisfactionSubmittedAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activities      InquiryActivity[]
  // 고객·관리자 모두에게 보이는 대화 쓰레드. 관리자 전용 내부 메모인
  // InquiryActivity와는 분리된 별개 모델이다 — 섞이면 내부 메모가 고객에게
  // 노출되는 사고로 이어지기 쉽다.
  messages        InquiryMessage[]
  linkTokens      InquiryLinkToken[]

  @@index([status, createdAt])
  @@index([assigneeId])
  @@index([userId])
}

// 고객·관리자 간 문의 대화. append-only — InquiryActivity와 같은 원칙으로
// 수정·삭제 API를 의도적으로 만들지 않는다. 관리자의 최초 답변도 이
// 쓰레드의 첫 메시지일 뿐, 별도의 "공식 답변" 개념을 두지 않는다.
model InquiryMessage {
  id          String   @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  // "CUSTOMER" | "ADMIN"
  senderRole  String
  body        String
  // 발신자가 나중에 탈퇴·강등돼도 기록이 남도록 스냅샷을 함께 저장한다
  // (InquiryActivity의 actorEmail/actorName과 같은 원칙).
  senderId    String?
  senderEmail String?
  senderName  String?
  createdAt   DateTime @default(now())

  @@index([inquiryId, createdAt])
}

// 비회원으로 접수된 문의를 회원 계정에 연결하기 전 이메일 소유를 확인하는
// 토큰. PasswordResetToken과 완전히 같은 원자적 소비 원칙을 쓴다 — 원문 대신
// 해시만 저장한다.
model InquiryLinkToken {
  id        String    @id @default(cuid())
  inquiryId String
  inquiry   Inquiry   @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([inquiryId])
  @@index([userId])
}

// 문의의 접수부터 상태·담당자·다음 액션·메모·연락 기록까지 전체 이력을 남기는
// append-only 감사 로그. 수정·삭제 API를 의도적으로 만들지 않는다 — 잘못
// 남긴 기록은 정정 메모(NOTE_ADDED)를 새로 추가하는 방식으로 운영한다.
// action: CREATED|ASSIGNED|UNASSIGNED|STATUS_CHANGED|NEXT_ACTION_CHANGED|
//   NOTE_ADDED|CONTACT_LOGGED|SATISFACTION_RATED (src/data/inquiryActivity.ts)
model InquiryActivity {
  id         String   @id @default(cuid())
  inquiryId  String
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  action     String
  // 변경 전후 값(예: {"from":"신규","to":"검토 중"}). 액션마다 담는 내용이 다르다.
  changes    Json?
  // CREATED 시점의 문의 스냅샷. 원문 접수 내용을 나중에 문의 자체가 수정돼도
  // 그대로 남긴다(현재 Inquiry에는 수정 API가 없지만, 감사 로그 원칙상 원본을
  // 별도로 고정해 둔다).
  snapshot   Json?
  note       String?
  // 시스템(공개 접수, 데이터 마이그레이션)이 남긴 활동은 actor가 없다.
  // actorId가 나중에 삭제돼도(관리자 탈퇴 등) 감사 기록이 남도록 actorEmail·
  // actorName을 스냅샷으로 함께 저장한다 — actorId만으로 조인하지 않는다.
  actorId    String?
  actorEmail String?
  actorName  String?
  createdAt  DateTime @default(now())

  @@index([inquiryId, createdAt])
}
