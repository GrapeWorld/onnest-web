{
  "name": "onnest-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "set-admin": "node --env-file=.env scripts/set-admin.mjs",
