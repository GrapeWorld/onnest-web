    "test:content": "node --experimental-strip-types scripts/check-handover-content.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@vercel/blob": "^2.6.1",
    "bcryptjs": "^3.0.3",
